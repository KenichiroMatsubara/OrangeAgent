{
  "name": "mail-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.2.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run db:local && npm run dev -w @mail/web",
    "dev:mock": "npm run dev:mock -w @mail/web",
    "build": "npm run build -w @mail/domain && npm run build -w @mail/t3chat && npm run build -w @mail/web && npm run build -w @mail/worker",
    "typecheck": "npm run typecheck --workspaces --if-present && tsrs -p tsconfig.tools.json",
    "lint": "TSRS_FAST=1 oxlint --type-aware .",
    "test": "npm run test:unit && npm run test:d1 && npm run test:do",
    "test:unit": "vitest run",
    "test:d1": "vitest run --config vitest.d1.config.ts",
    "test:do": "vitest run --config vitest.do.config.ts",
    "db:local": "npm run db:local -w @mail/worker",
    "db:studio": "tsx scripts/db-browser.ts",
    "lent": "tsx scripts/lent.ts",
    "db:drizzle": "drizzle-kit studio --config=drizzle.config.ts",
    "db:generate:control": "drizzle-kit generate --config=drizzle.control.config.ts",
    "db:generate:account": "drizzle-kit generate --config=drizzle.account.config.ts",
    "db:rehearse:remote": "node --import tsx --import ./scripts/register-sql-text-loader.mjs scripts/rehearse-migrations.ts",
    "db:migrate:control:remote": "wrangler d1 migrations apply CONTROL_DB --remote --config apps/worker/wrangler.deploy.json",
    "db:migrate:organization:remote": "node --import tsx --import ./scripts/register-sql-text-loader.mjs scripts/migrate-organization-fleet.ts prepare",
    "db:migrate:complete:remote": "node --import tsx --import ./scripts/register-sql-text-loader.mjs scripts/migrate-organization-fleet.ts complete",
    "memory:index:remote": "node --import tsx --import ./scripts/register-sql-text-loader.mjs scripts/memory-index.ts",
    "deploy:cloudflare": "npm run deploy:config && npm run db:rehearse:remote && npm run db:migrate:control:remote && npm run db:migrate:organization:remote && npm run memory:index:remote && npm run deploy:worker:release -w @mail/worker && npm run db:migrate:complete:remote",
    "deploy": "npm run build && npm run deploy:cloudflare",
    "deploy:config": "node --import tsx scripts/deploy-config.ts",
    "deploy:preview": "npm run deploy:config && npm run deploy:worker:preview -w @mail/worker"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@cloudflare/workers-types": "^5.20260722.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "better-sqlite3": "^13.0.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "json5": "^2.2.3",
    "oxlint": "^1.94.0",
    "tsrs": "7.1.0-beta.tsrs4",
    "tsx": "^4.23.1",
    "vitest": "^5.1.1",
    "wrangler": "~4.164.0"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=12"
  },
  "allowScripts": {
    "workerd": true,
    "esbuild": true,
    "better-sqlite3": true
  }
}
