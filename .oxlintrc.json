{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "warn"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/.wrangler/**",
    "apps/worker/lent/**"
  ],
  "rules": {
    "typescript/no-explicit-any": "error"
  },
  "overrides": [
    {
      "files": [
        "packages/t3chat/**"
      ],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    }
  ]
}
